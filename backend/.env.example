PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/bizbuilder
JWT_SECRET=replace_with_a_secure_secret_at_least_32_chars
CORS_ORIGIN=http://localhost:5173
# Production: your Vercel frontend URL (comma-separate multiple origins if needed)
# CORS_ORIGIN=https://your-app.vercel.app
API_URL=http://localhost:5000
# Production: your Railway public URL (for Swagger server list)
# API_URL=https://your-app.up.railway.app
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL for order tracking and delivery person links in WhatsApp messages
FRONTEND_URL=http://localhost:5173
# Alternative name (FRONTEND_URL takes precedence)
# STOREFRONT_URL=http://localhost:5173

# WhatsApp (Meta Cloud API) — optional; logs and skips if unset
WHATSAPP_API_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Optional override (default: https://graph.facebook.com/v21.0)
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
